{
  "name": "analytics-worker",
  "version": "0.2.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.9.3",
    "wrangler": "4.129.0"
  },
  "private": true,
  "scripts": {
    "build:cf:production": "wrangler deploy --dry-run --config wrangler.toml --env=\"\" --outdir .wrangler-build/production",
    "build:cf:sandbox": "wrangler deploy --dry-run --config wrangler.toml --env sandbox",
    "dev": "wrangler dev",
    "deploy:production": "bun ../../../scripts/release/cloudflare/production-entrypoint.ts --worker manhali-analytics",
    "deploy:sandbox": "wrangler deploy --config wrangler.toml --env sandbox",
    "tail": "wrangler tail",
    "test": "bun test"
  },
  "type": "module"
}
